Notebook[{

Cell[CellGroupData[{
Cell["RSJ model with serial resistance", "Title",
 CellChangeTimes->{{3.952065212297929*^9, 3.9520652236864443`*^9}, {
  3.9947587775693893`*^9, 3.994758785753018*^9}, {3.9977653731796913`*^9, 
  3.9977653741496773`*^9}},ExpressionUUID->"145513d1-a58e-42b7-bb8f-\
dede5d79ac51"],

Cell["Effective RSJ model under a biharmonic voltage drive, with a series resistor. The phase obeys a first-order equation; the calculated mean phase velocity and current give the voltage-current trace. See Sec. 7 (Effective RSJ model) of https://arxiv.org/pdf/2610.05536 for the physical model and normalization.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"(*", " Biharmonic drive: fundamental Vac, second harmonic Vac2, relative phase delta; R and Rs set the resistive channels. ", "*)"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"set", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Omega]", "\[Rule]", "0.001"}], ",", 
     RowBox[{"Vac", "->", "0.666"}], ",", 
     RowBox[{"Vac2", "->", "0.333"}], ",", 
     RowBox[{"\[Delta]", "->", 
      RowBox[{"\[Pi]", "/", "2"}]}], ",", 
     RowBox[{"R", "->", "2"}], ",", 
     RowBox[{"Rs", "->", "1"}], ",", 
     RowBox[{"periods", "\[Rule]", "4"}], ",", 
     RowBox[{"calculatePart", "\[Rule]", "0.5"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"(*", " Sweep the applied dc bias; solve the overdamped phase equation for each Vdc in parallel. ", "*)"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"lineTraceC0", "=", "\[IndentingNewLine]", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"y", "'"}], "[", "x", "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"1", "/", "R"}], "+", 
                RowBox[{"1", "/", "Rs"}]}], ")"}]}], "\[Equal]", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "1"}], 
               RowBox[{"Cos", "[", 
                RowBox[{"y", "[", "x", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Vdc", "+", 
                 RowBox[{"Vac", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"\[Omega]", " ", "x"}], "]"}]}], "+", 
                 RowBox[{"Vac2", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{
                    RowBox[{"2", "\[Omega]", " ", "x"}], "+", "\[Delta]"}], 
                   "]"}]}]}], ")"}], "/", "Rs"}]}]}], ",", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], "/.", 
          "set"}], ",", "y", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"periods", " ", 
             FractionBox[
              RowBox[{"2", "\[Pi]"}], "\[Omega]"]}]}], "}"}], "/.", "set"}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{
                 FractionBox[
                  RowBox[{"2", "\[Pi]"}], "\[Omega]"], "periods"}], "]"}], "-", 
               RowBox[{"y", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "calculatePart"}], ")"}], 
                 FractionBox[
                  RowBox[{"2", "\[Pi]"}], "\[Omega]"], "periods"}], "]"}]}], 
              RowBox[{"calculatePart", 
               FractionBox[
                RowBox[{"2", "\[Pi]"}], "\[Omega]"], "periods"}]], ")"}], "/.",
             "sol"}], "/.", "set"}], ")"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Vdc", "-", 
               FractionBox[
                RowBox[{
                 RowBox[{"y", "[", 
                  RowBox[{
                   FractionBox[
                    RowBox[{"2", "\[Pi]"}], "\[Omega]"], "periods"}], "]"}], "-", 
                 RowBox[{"y", "[", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "calculatePart"}], ")"}], 
                   FractionBox[
                    RowBox[{"2", "\[Pi]"}], "\[Omega]"], "periods"}], "]"}]}], 
                RowBox[{"calculatePart", 
                 FractionBox[
                  RowBox[{"2", "\[Pi]"}], "\[Omega]"], "periods"}]]}], ")"}], 
             "/", "Rs"}], "/.", "sol"}], "/.", "set"}], ")"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"Vdc", ",", 
       RowBox[{"-", "5"}], ",", "5", ",", "0.005"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"(*", " Plot the pairs {mean phase velocity, mean current}; the phase velocity is proportional to the junction voltage. ", "*)"}], "\[IndentingNewLine]",
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"lineTraceC0", ",", 
   RowBox[{"PlotStyle", "->", "Thick"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<V_{dc}\>\"", ",", "\"\<<I>\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.898236926124626*^9, 3.898237017660715*^9}, {
