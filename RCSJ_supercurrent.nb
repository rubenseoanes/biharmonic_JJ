Cell["Export: lineTrace_V_I.dat is a two-column table containing the calculated mean phase velocity (junction-voltage coordinate) and the corresponding mean current. The file is written to NotebookDirectory[].", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<lineTrace_V_I.dat\>\""}], "}"}], "]"}], ",", "lineTraceC0", 
   ",", "\"\<Table\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.998364156048698*^9, 3.998364171683062*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"d80f3cc7-ec2f-469f-ae84-ee4e0c41b1d3"],

Cell[BoxData["\<\"/Users/rubenseoane/Dropbox/Talento/2026/dualDiode_Elia/\
lineTrace_V_I.dat\"\>"], "Output",
 CellChangeTimes->{3.998364173605226*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"c05da11b-205a-432a-8a03-51edf2048bab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plotting dynamics for some cases", "Subsection",
 CellChangeTimes->{{3.9983884659957457`*^9, 
  3.998388480870851*^9}},ExpressionUUID->"a6ac2c27-aa01-4d47-89f7-\
00cc3870477b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"(*", " Inspect one representative dc bias Vdc0 using the same drive and resistance parameters. ", "*)"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"set", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Omega]", "->", "0.001"}], ",", 
     RowBox[{"Vac", "->", "0.666"}], ",", 
     RowBox[{"Vac2", "->", "0.333"}], ",", 
     RowBox[{"\[Delta]", "->", 
      RowBox[{"\[Pi]", "/", "2"}]}], ",", 
     RowBox[{"R", "->", "2"}], ",", 
     RowBox[{"Rs", "->", "1"}], ",", 
     RowBox[{"periods", "->", "4"}], ",", 
     RowBox[{"calculatePart", "->", "0.5"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vdc0", "=", "1.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tmax", "=", 
   RowBox[{
    RowBox[{"periods", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]"}], ")"}], "/", "\[Omega]"}]}], "/.", " ", 
    "set"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ysol", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"1", "/", "R"}], "+", 
             RowBox[{"1", "/", "Rs"}]}], ")"}]}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Vdc0", "+", 
              RowBox[{"Vac", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Omega]", " ", "t"}], "]"}]}], "+", 
              RowBox[{"Vac2", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{
                 RowBox[{"2", " ", "\[Omega]", " ", "t"}], "+", "\[Delta]"}], 
                "]"}]}]}], ")"}], "/", "Rs"}]}]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "0"}]}], "}"}], "/.", " ", 
       "set"}], ",", "y", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " Average y'(t) over the final calculatePart fraction of the trajectory to reduce transients. ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"avgYprime", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ysol", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]"}], ")"}], "/", "\[Omega]"}], " ", 
         "periods"}], "]"}], "-", 
       RowBox[{"ysol", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "calculatePart"}], ")"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]"}], ")"}], "/", "\[Omega]"}], " ", 
         "periods"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"calculatePart", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Pi]"}], ")"}], "/", "\[Omega]"}], " ", 
       "periods"}], ")"}]}], "/.", " ", "set"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"current", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Vdc0", "-", "avgYprime"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"Rs", "/.", " ", "set"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<<y'> = \>\"", ",", "avgYprime"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<I = \>\"", ",", "current"}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " Plot the phase y(t) and its time derivative; the mean current is (Vdc0 - <y'>)/Rs. ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ysol", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", "Thick"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ysol", "'"}], "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", "Thick"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<y'(t)\>\""}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9983884914217997`*^9, 3.9983885334459057`*^9}, {
  3.998388752811235*^9, 3.998388868449232*^9}, {3.998389005656186*^9, 
  3.998389038565703*^9}, {3.99838909447235*^9, 3.998389095667227*^9}, {
  3.9983891961658792`*^9, 3.998389272780528*^9}, {3.998389416310817*^9, 
  3.998389448954179*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"ee33684f-c1a0-4d7a-bd40-b401974cc56d"],

